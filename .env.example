# ============================================================================
#  SangamIQ — Environment Variables
#  Copy to .env and fill in values. Every optional var has a working fallback.
#  See PROJECT_SPEC.md > Free-stack rules for the zero-cost policy.
# ============================================================================

# --- Server -------------------------------------------------------------------

# REQUIRED — Port the Express server listens on
PORT=3001

# --- Database -----------------------------------------------------------------

# OPTIONAL (free) — PostgreSQL + PostGIS connection string
# Local Docker: postgres://postgres:postgrespassword@localhost:5432/sangamiq
# Neon free tier: get a connection string at https://neon.tech (no credit card)
# Supabase free tier: https://supabase.com (no credit card)
# If empty or missing, set USE_MEMORY_DB=true (or it defaults to true).
DATABASE_URL=

# OPTIONAL — Set true to skip PostgreSQL entirely and use the in-memory store.
# Automatically true when DATABASE_URL is empty. Data resets on restart.
USE_MEMORY_DB=true

# --- Authentication -----------------------------------------------------------

# OPTIONAL (free) — JWT signing secret. Change this in production!
# Falls back to a hardcoded dev secret if missing (insecure; fine for local dev).
JWT_SECRET=sangamiq-dev-secret-change-in-production

# OPTIONAL (free) — Accept the dev OTP code 123456 for phone login.
# Set to false in production. Default: true
DEV_OTP=true

# OPTIONAL (free) — OTP delivery provider: console | twilio | msg91 | exotel
# "console" prints the OTP to the server log — no SMS account needed.
# Default: console
OTP_PROVIDER=console

# OPTIONAL (paid) — Only needed if OTP_PROVIDER=twilio
# Free trial at https://www.twilio.com/try-twilio (requires credit card for trial)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# OPTIONAL (paid) — Only needed if OTP_PROVIDER=msg91
# Free trial at https://msg91.com
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# OPTIONAL (paid) — Only needed if OTP_PROVIDER=exotel
# Free trial at https://exotel.com
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=

# --- Maps ---------------------------------------------------------------------

# OPTIONAL (free) — Raster tile URL template for Leaflet.
# Leave empty (default) to use OpenFreeMap vector tiles via MapLibre GL
# (free, no API key, no rate limits, commercial use OK: https://openfreemap.org).
#
# Set to override with any raster tile provider:
#   CARTO Voyager (free key, no CC): https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY
#     Get free key: https://carto.com/basemaps/apikey (5M tiles/mo non-commercial)
#   MapTiler (free key, no CC): https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#     Get free key: https://cloud.maptiler.com/account/keys (no credit card)
#   Stadia Maps (free key, no CC): https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}.png?api_key=YOUR_KEY
#     Get free key: https://client.stadiamaps.com (200K tiles/mo free)
#   Self-hosted Protomaps: http://localhost:8080/{z}/{x}/{y}.png
# Do NOT use tile.openstreetmap.org (usage policy forbids apps like ours).
# VITE_TILE_URL=

# OPTIONAL — Custom attribution HTML (shown on map corner).
# Default when using raster: "© OpenStreetMap contributors"
# Default when using OpenFreeMap: "© OpenFreeMap OpenMapTiles Data © OSM"
# VITE_TILE_ATTRIBUTION=

# OPTIONAL — Tile subdomains for load balancing (default: "abc").
# Only used when VITE_TILE_URL contains {s} placeholder.
# VITE_TILE_SUBDOMAINS=abc

# --- Voice AI: Speech-to-Text (STT) ------------------------------------------

# OPTIONAL (free) — STT provider: whisper | google | mock
# "mock" (default) relies on the browser's free SpeechRecognition API.
# Whisper via Groq free tier: https://console.groq.com (no credit card, generous free quota)
# Whisper via OpenAI: https://platform.openai.com (free credits on sign-up)
# Google Cloud STT: https://cloud.google.com/speech-to-text (free tier: 60 min/month)
STT_PROVIDER=mock

# OPTIONAL (free tier available) — Only needed if STT_PROVIDER=whisper
# Groq key works with OpenAI-compatible Whisper endpoint.
# Get free key: https://console.groq.com/keys
# WHISPER_API_KEY=
# WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions

# OPTIONAL (free tier available) — Only needed if STT_PROVIDER=google
# Get key: https://console.cloud.google.com/apis/credentials
# GOOGLE_API_KEY=

# --- Voice AI: LLM Intent Classifier -----------------------------------------

# OPTIONAL (free) — LLM provider: gemini | groq | claude | openai | ollama | keyword
# "keyword" (default) uses the built-in keyword classifier — no API key, no cost.
# Auto-detection: if no LLM_PROVIDER is set, the system checks for available API
# keys and uses the first it finds; otherwise falls back to keyword.
#
# Free tiers (no credit card):
#   Gemini: https://aistudio.google.com/apikey (free tier: 15 RPM)
#   Groq:   https://console.groq.com/keys (free tier: 30 RPM)
# Self-hosted (free, unlimited):
#   Ollama: https://ollama.com — run models locally
LLM_PROVIDER=keyword

# OPTIONAL (free tier) — Only needed if LLM_PROVIDER=gemini
# Get free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OPTIONAL (free tier) — Only needed if LLM_PROVIDER=groq
# Get free key: https://console.groq.com/keys
# GROQ_API_KEY=

# OPTIONAL (paid, has free credits) — Only needed if LLM_PROVIDER=claude
# https://console.anthropic.com (requires credit card)
# ANTHROPIC_API_KEY=

# OPTIONAL (paid, has free credits) — Only needed if LLM_PROVIDER=openai
# https://platform.openai.com (free credits on sign-up)
# OPENAI_API_KEY=

# OPTIONAL (free, self-hosted) — Only needed if LLM_PROVIDER=ollama
# Default: http://localhost:11434 (Ollama default)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- Voice AI: Text-to-Speech (TTS) ------------------------------------------

# OPTIONAL (free) — TTS provider: google | browser
# "browser" (default) uses the browser's free speechSynthesis API.
# Google Cloud TTS: https://cloud.google.com/text-to-speech (free tier: 4M chars/month)
TTS_PROVIDER=browser

# OPTIONAL (free tier) — Only needed if TTS_PROVIDER=google
# Same GOOGLE_API_KEY as above, or a separate one.
# GOOGLE_TTS_API_KEY=

# --- IVR / Telephony ---------------------------------------------------------

# OPTIONAL (free) — IVR provider: simulator | twilio | exotel
# "simulator" (default) runs a local IVR simulator for demo/testing.
# No telephony account required.
IVR_PROVIDER=simulator

# OPTIONAL (paid, free trial) — Only needed if IVR_PROVIDER=twilio or exotel
# Reuses TWILIO_* or EXOTEL_* vars from the Auth section above.

# --- Messaging ----------------------------------------------------------------

# OPTIONAL (free) — Telegram Bot API token for notifications
# Create a bot at https://t.me/BotFather (free, no limits)
# TELEGRAM_BOT_TOKEN=

# wa.me share links and sms: URI scheme are device-native — no env var needed.

# --- Push Notifications -------------------------------------------------------

# OPTIONAL (free) — VAPID keys for Web Push (standards-based, no vendor)
# Generate with: npx web-push generate-vapid-keys
# If missing, push is disabled; SSE stream remains the real-time fallback.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:pranavmhasaye2347@gmail.com

# --- Billing ------------------------------------------------------------------

# OPTIONAL (free) — Enable billing UI and payment processing
# Default: false (all features unlocked, no payment flow)
# When true, only mock/test-mode payments are processed.
BILLING_ENABLED=false

# --- Client -------------------------------------------------------------------

# OPTIONAL — Only needed if the API is hosted on a different origin than the web app
# VITE_API_URL=http://localhost:3001
