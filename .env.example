# Server configuration
PORT=3001

# PostgreSQL + PostGIS database connection string
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/sangamiq

# Set to true to run with in-memory fallback without PostgreSQL
USE_MEMORY_DB=false

# Authentication
DEV_OTP=true
OTP_PROVIDER=console
JWT_SECRET=sangamiq-dev-secret-change-in-production

# Client (only needed if the API is hosted on a different origin than the web app)
# VITE_API_URL=http://localhost:3001
