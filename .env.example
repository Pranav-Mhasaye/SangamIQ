# Server configuration
PORT=3001

# PostgreSQL + PostGIS database connection string
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/sangamiq

# Set to true to run with in-memory fallback without PostgreSQL
USE_MEMORY_DB=false

# Authentication
DEV_OTP=true
OTP_PROVIDER=console
JWT_SECRET=sangamiq-dev-secret-change-in-production

# Voice AI & NLU Configuration
# LLM Intent Classifier: gemini | claude | openai | keyword (default: auto-detected or keyword)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Speech-to-Text (STT) Provider: whisper | google | mock (default: mock/free browser SpeechRecognition)
STT_PROVIDER=whisper
WHISPER_API_KEY=
# GOOGLE_API_KEY=

# Text-to-Speech (TTS) Provider: google | browser (default: browser speechSynthesis)
TTS_PROVIDER=browser

# Client (only needed if the API is hosted on a different origin than the web app)
# VITE_API_URL=http://localhost:3001
